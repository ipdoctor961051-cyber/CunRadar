# ============================================================
# CunRadar 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# AI Provider：cloudflare | deepseek
AI_PROVIDER=cloudflare

# Cloudflare Workers AI（推荐）
AI_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# DeepSeek（备用及向后兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Telegram Bot 配置（用于推送日报，可选）
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# GitHub Token（可选，用于提高 API 速率限制）
# 不配置也能用，但每小时只能请求 60 次
GITHUB_TOKEN=

# ─── 关注列表（可选） ──────────────────────────────────────
# 如果不想把关注列表放在 config.yaml 中提交到公开仓库，
# 可以通过此环境变量传入（JSON 格式），优先级高于 config.yaml。
#
# 格式示例（村长的信息）：
# FOLLOW_CONFIG={"youtube":[{"name":"Web3村长","channel_id":"UC5MbekhrH8iyFBQLbccBSRg"}],"bilibili":[{"name":"Web3村长Official","uid":1224034462}],"rss":[{"name":"村长博客","url":"https://cunzhangblog.com/rss.xml"}],"github":[{"name":"CunRadar","repo":"cunzhangcrypto/CunRadar"}],"github_trending":{"enabled":true,"language":"","limit":5}}
#
# FOLLOW_CONFIG=
